<?xml version="1.0" encoding="utf-8"?>
<!-- Original Selura brand mark; no network or external asset needed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/selura_launch_bg_start"
                android:endColor="@color/selura_launch_bg_end" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/selura_launch_mark"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp" />
</layer-list>
